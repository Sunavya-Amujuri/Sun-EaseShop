# Let Lombok's generated constructors carry Spring's injection annotations through to the
# constructor parameters. Without this, a field-level @Qualifier is silently dropped by
# @RequiredArgsConstructor and Spring injects by type instead - which picks the wrong bean as soon
# as two beans of the same type exist (here: the conversational vs memory-free ChatClient).
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
